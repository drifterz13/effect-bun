  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@effect/sql-sqlite-bun": "4.0.0-beta.106",
    "effect": "4.0.0-beta.106"
  }
}
